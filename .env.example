# ============================================================
# 啟動必要設定（bootstrap）— 這些無法在 /settings 修改
# ============================================================
PORT=8090
# 執行期設定的儲存檔（可在 /settings 頁面修改的項目都存在這裡）
SETTINGS_PATH=./settings.json
# LINE 登入 token 儲存位置
STORAGE_PATH=./storage.json
# log 檔路徑
LOG_FILE=./logs/app.log
# 收到的訊息持久化檔（JSONL）；可在 /settings 開關，路徑固定於此
MESSAGES_PATH=./data/messages.jsonl
# 排程訊息持久化檔（重啟後恢復未到期的排程）
SCHEDULES_PATH=./data/schedules.json
# 發送統計（JSONL，供儀表板）
STATS_PATH=./data/stats.jsonl
# 儀表板統計顯示天數
STATS_DAYS=14
# 網頁上傳檔案儲存目錄
UPLOADS_PATH=./data/uploads
# Skill 資料快取目錄（持久化，重啟仍可用；TTL 於各技能設定）
CACHE_PATH=./data/cache
# 請求 body 大小上限（MB），影響上傳與 webhook 內容
MAX_BODY_MB=25
# 設定頁登入帳密（設定頁一律需要登入，閒置 5 分鐘需重新登入）
# 留空會自動產生臨時密碼並顯示於 console（重啟會變，建議設定）
STATUS_USER=
STATUS_PASS=
# 於網頁「變更密碼」後，新密碼（scrypt 雜湊）會存到這個檔案並覆蓋上面的設定
AUTH_PATH=./data/auth.json
# 介面語言初始值：zh / en / ja（之後可在側欄切換，存於 settings.json）
LANGUAGE=zh
# 時區（IANA，例如 Asia/Taipei、UTC）；影響 log 時間與技能（如「今天」判斷）
TIMEZONE=Asia/Taipei

# ============================================================
# 以下為「初始預設值」；多數項目建議在 /settings 頁面設定。
# settings.json 存在時會覆蓋這裡的值（.env < settings.json）。
# ============================================================

# 允許的來源 IP，逗號分隔；留空 = 不限制
ALLOWED_IPS=
# HMAC-SHA256 簽章密鑰；留空 = 不驗證簽章
HMAC_SECRET=
# 是否啟用 HMAC 簽章驗證（1/true/on 啟用；預設啟用，關閉視同未設定）
HMAC_ENABLED=true
HMAC_MAX_SKEW_SEC=300
# URL token（供無法簽章的來源）：網址帶 ?token=... 或標頭 X-Webhook-Token
# 與 HMAC 並存時任一通過即可；兩者皆空 = 不驗證
WEBHOOK_TOKEN=
# 是否啟用 URL Token 驗證（預設啟用；URL 易留存於 log，建議只留一種驗證方式）
WEBHOOK_TOKEN_ENABLED=true
# API Token（Bearer）：標頭 Authorization: Bearer <token>
# 與 HMAC / URL token 並存時任一通過即可；三者皆空 = 不驗證
API_TOKEN=
# 是否啟用 API Token（含多組具名 token）驗證，預設啟用
API_TOKEN_ENABLED=true
# 管理頁面（狀態 / 設定 / 訊息 / ReadMe / 登入）是否僅限私人 IP（內網）存取；webhook 不受影響
ADMIN_PRIVATE_ONLY=false

# LINE 登入
LINE_DEVICE=DESKTOPWIN
LINE_DEVICE_NAME=LINE Webhook
LINE_MODEL_NAME=LINE Webhook
# 目標對照表：名稱=mid，多筆用逗號分隔
# TARGETS=小明=u1234567890abcdef,測試群=Cabcdef1234567890

# Telegram Bot（可與 LINE 同時上線；多數項目建議在 /settings 頁面設定）
# TELEGRAM_ENABLED=1
# 向 @BotFather 申請
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# setWebhook 時用的 secret_token（Telegram 會以 X-Telegram-Bot-Api-Secret-Token 帶回）
# TELEGRAM_SECRET_TOKEN=
# 對外可存取、結尾固定為 /tg/update 的網址；設定後啟動會自動 setWebhook
# TELEGRAM_WEBHOOK_URL=https://example.com/tg/update
# Telegram 目標對照表：名稱=chat_id，多筆用逗號分隔（也可填 @username）
# TELEGRAM_TARGETS=我的群組=-1001234567890

# 發送佇列 / 重試 / 速率限制
SEND_MAX_RETRIES=3
SEND_RETRY_BASE_MS=500
SEND_MIN_INTERVAL_MS=200

# 接收端速率限制（每個 IP）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# 回覆文字上限（字元）；超過會自動分段送出（0 = 不限制）
REPLY_MAX_CHARS=4000

# 監控
HEALTH_CHECK_INTERVAL_SEC=60
LOG_LIMIT=200
# log 輪替：超過此大小（bytes）就輪替；保留幾個舊檔
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=5
# 收到的訊息持久化（初始預設；建議在 /settings 設定）
MESSAGES_PERSIST=false

# Email 通知（SMTP）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
