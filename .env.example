# ============================================================
# 啟動必要設定（bootstrap）— 這些無法在 /settings 修改
# ============================================================
PORT=8090
# 執行期設定的儲存檔（可在 /settings 頁面修改的項目都存在這裡）
SETTINGS_PATH=./settings.json
# LINE 登入 token 儲存位置
STORAGE_PATH=./storage.json
# log 檔路徑
LOG_FILE=./logs/app.log
# 收到的訊息持久化檔（JSONL）；可在 /settings 開關，路徑固定於此
MESSAGES_PATH=./data/messages.jsonl
# 訊息保留天數（0 = 不修剪；開機與每日修剪記憶體＋檔案）
MESSAGES_RETENTION_DAYS=30
# 上傳檔保留天數（0 = 不清理）與總量上限 MB（0 = 不限制；超過拒絕新上傳）
UPLOADS_RETENTION_DAYS=30
UPLOADS_MAX_MB=2048
# 收訊落地檔（先寫盤再回 200 的保險，崩潰追溯用）
INBOUND_QUEUE_PATH=./data/inbound-queue.jsonl
# 死信檔（永久性發送失敗的紀錄）
DEADLETTER_PATH=./data/deadletter.jsonl
# 排程訊息持久化檔（重啟後恢復未到期的排程）
SCHEDULES_PATH=./data/schedules.json
# 發送統計流水檔（jsonl 模式為主檔；sqlite 模式開機遷移後封存為 .migrated）
STATS_PATH=./data/stats.jsonl
# 儀表板統計顯示天數
STATS_DAYS=14
# 統一儲存層（A6）：sqlite = 可查詢/保留政策（Node ≥22.13 內建）；jsonl = 備援（純檔案掃描）
STORAGE_KIND=sqlite
# SQLite 資料庫路徑（開機會自動把既有 messages/stats/deadletter JSONL 遷移進來）
DB_PATH=./data/imweb.db
# 網頁上傳檔案儲存目錄
UPLOADS_PATH=./data/uploads
# Skill 資料快取目錄（持久化，重啟仍可用；TTL 於各技能設定）
CACHE_PATH=./data/cache
# 請求 body 大小上限（MB），影響上傳與 webhook 內容
MAX_BODY_MB=25
# 設定頁登入帳密（設定頁一律需要登入，閒置 5 分鐘需重新登入）
# 留空會自動產生臨時密碼並顯示於 console（重啟會變，建議設定）
STATUS_USER=
STATUS_PASS=
# 於網頁「變更密碼」後，新密碼（scrypt 雜湊）會存到這個檔案並覆蓋上面的設定
AUTH_PATH=./data/auth.json
# 介面語言初始值：zh / en / ja（之後可在側欄切換，存於 settings.json）
LANGUAGE=zh
# 時區（IANA，例如 Asia/Taipei、UTC）；影響 log 時間與技能（如「今天」判斷）
TIMEZONE=Asia/Taipei

# ------------------------------------------------------------
# 正式部署建議：把「執行期檔案」移出部署目錄
# 部署只更新程式碼，runtime 檔案放固定位置，就不會每次部署被覆蓋
# （settings.json 是執行期資料庫：助理 / 技能 / 目標對照 / 密鑰都在裡面）。
# 取消註解並改成你的路徑即可；目錄需先建立。
# ------------------------------------------------------------
# SETTINGS_PATH=/var/lib/line-webhook/settings.json
# STORAGE_PATH=/var/lib/line-webhook/storage.json
# AUTH_PATH=/var/lib/line-webhook/auth.json
# MESSAGES_PATH=/var/lib/line-webhook/data/messages.jsonl
# SCHEDULES_PATH=/var/lib/line-webhook/data/schedules.json
# STATS_PATH=/var/lib/line-webhook/data/stats.jsonl
# UPLOADS_PATH=/var/lib/line-webhook/data/uploads
# SKILLS_PATH=/var/lib/line-webhook/data/skills
# CACHE_PATH=/var/lib/line-webhook/data/cache
# LOG_FILE=/var/log/line-webhook/app.log

# ============================================================
# 以下為「初始預設值」；多數項目建議在 /settings 頁面設定。
# settings.json 存在時會覆蓋這裡的值（.env < settings.json）。
# ============================================================

# 允許的來源 IP，逗號分隔；留空 = 不限制
ALLOWED_IPS=
# HMAC-SHA256 簽章密鑰；留空 = 不驗證簽章
HMAC_SECRET=
# 是否啟用 HMAC 簽章驗證（1/true/on 啟用；預設啟用，關閉視同未設定）
HMAC_ENABLED=true
HMAC_MAX_SKEW_SEC=300
# URL token（供無法簽章的來源）：網址帶 ?token=... 或標頭 X-Webhook-Token
# 與 HMAC 並存時任一通過即可；兩者皆空 = 不驗證
WEBHOOK_TOKEN=
# 是否啟用 URL Token 驗證（預設啟用；URL 易留存於 log，建議只留一種驗證方式）
WEBHOOK_TOKEN_ENABLED=true
# API Token（Bearer）：標頭 Authorization: Bearer <token>
# 與 HMAC / URL token 並存時任一通過即可；三者皆空 = 不驗證
API_TOKEN=
# 是否啟用 API Token（含多組具名 token）驗證，預設啟用
API_TOKEN_ENABLED=true
# 管理頁面（狀態 / 設定 / 訊息 / ReadMe / 登入）是否僅限私人 IP（內網）存取；webhook 不受影響
ADMIN_PRIVATE_ONLY=false

# LINE 登入
LINE_DEVICE=DESKTOPWIN
LINE_DEVICE_NAME=IM Webhook
LINE_MODEL_NAME=IM Webhook
# 目標對照表：名稱=mid，多筆用逗號分隔
# TARGETS=小明=u1234567890abcdef,測試群=Cabcdef1234567890

# Telegram Bot（可與 LINE 同時上線；多數項目建議在 /settings 頁面設定）
# TELEGRAM_ENABLED=1
# 向 @BotFather 申請
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# setWebhook 時用的 secret_token（Telegram 會以 X-Telegram-Bot-Api-Secret-Token 帶回）
# TELEGRAM_SECRET_TOKEN=
# 對外可存取、結尾固定為 /tg/update 的網址；設定後啟動會自動 setWebhook
# TELEGRAM_WEBHOOK_URL=https://example.com/tg/update
# Telegram 目標對照表：名稱=chat_id，多筆用逗號分隔（也可填 @username）
# TELEGRAM_TARGETS=我的群組=-1001234567890

# WhatsApp（可與 LINE / Telegram 同時上線；多數項目建議在 /settings 頁面設定）
# WHATSAPP_ENABLED=1
# 模式：cloud = 官方 Cloud API；web = 個人帳號（WhatsApp Web，QR 登入）
# WHATSAPP_MODE=cloud
# --- Cloud API 模式 ---
# Meta 應用中的電話號碼 ID（數字）
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Meta 永久或臨時權杖（Bearer）
# WHATSAPP_ACCESS_TOKEN=EAA...
# Meta Webhook 訂閱驗證用的自訂字串（GET /wa/webhook）
# WHATSAPP_VERIFY_TOKEN=
# Meta 應用密鑰，用於驗證 X-Hub-Signature-256（留空 = 不驗簽章，不建議）
# WHATSAPP_APP_SECRET=
# Graph API 版本（預設 v21.0）
# WHATSAPP_API_VERSION=v21.0
# --- 個人帳號（web）模式 ---
# 登入 session 儲存目錄（刪除 = 登出並重新掃 QR）
# WHATSAPP_WEB_AUTH_PATH=./data/whatsapp-web
# WhatsApp 目標對照表：名稱=電話號碼（E.164，不含 +），多筆用逗號分隔
# WHATSAPP_TARGETS=小明=886912345678

# Microsoft Teams（企業 Bot，需 Azure Bot resource＋M365 tenant；多數項目建議在 /settings 頁面設定）
# TEAMS_ENABLED=1
# Azure Bot 的 Microsoft App ID（Entra 應用程式用戶端識別碼）
# TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
# Entra 應用程式的用戶端密碼（client secret）
# TEAMS_APP_PASSWORD=
# Entra 租用戶識別碼（single-tenant 就用這個）
# TEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000
# Bot Connector 服務端點（通常用預設；首次收訊後自動記憶實際值）
# TEAMS_SERVICE_URL=https://smba.trafficmanager.net/teams
# Teams 目標對照表：名稱=conversation id，多筆用逗號分隔（收到訊息後自動記住，可不填）
# TEAMS_TARGETS=客服頻道=19:abc@thread.v2

# 發送佇列 / 重試 / 速率限制
SEND_MAX_RETRIES=3
SEND_RETRY_BASE_MS=500
SEND_MIN_INTERVAL_MS=200
# 出站 idempotency 去重視窗（毫秒）
IDEMPOTENCY_WINDOW_MS=600000
# 三種 webhook 驗證全關時拒絕啟動；設 true 明確允許開放模式（僅測試用）
# ALLOW_OPEN_WEBHOOK=false

# 接收端速率限制（每個 IP）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# 回覆文字上限（字元）；超過會自動分段送出（0 = 不限制）
REPLY_MAX_CHARS=4000

# 監控
HEALTH_CHECK_INTERVAL_SEC=60
LOG_LIMIT=200
# 日誌等級：debug / info / warn / error（access log 只在 debug 輸出）
LOG_LEVEL=info
# log 輪替：超過此大小（bytes）就輪替；保留幾個舊檔
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=5
# 收到的訊息持久化（初始預設；建議在 /settings 設定）
MESSAGES_PERSIST=false

# Email 通知（SMTP）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
