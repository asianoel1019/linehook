{
  "name": "line-webhook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forward incoming webhook messages to LINE friends/groups via a logged-in LINE account",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@evex/linejs": "npm:@jsr/evex__linejs@^3.4.2",
    "@evex/linejs-types": "npm:@jsr/evex__linejs-types@^3.4.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fflate": "^0.8.3",
    "marked": "^18.0.14",
    "nodemailer": "^10.0.12",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
