{
  "name": "im-webhook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forward incoming webhook messages to multiple IM platforms (LINE, Telegram, ...)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tests/run.mjs",
    "test:coverage": "node tests/run.mjs --experimental-test-coverage tests/*.test.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests *.mjs *.cjs *.json *.md",
    "format:check": "prettier --check src tests *.mjs *.cjs *.json *.md"
  },
  "dependencies": {
    "@evex/linejs": "npm:@jsr/evex__linejs@^3.4.2",
    "@evex/linejs-types": "npm:@jsr/evex__linejs-types@^3.4.2",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fflate": "^0.8.3",
    "marked": "^18.0.14",
    "nodemailer": "^10.0.12",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.0"
  }
}
